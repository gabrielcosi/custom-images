{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "assignees": ["gabrielcosi"],
  "labels": ["renovate"],
  "configMigration": true,
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/"],
      "matchStrings": [
        "#\\s?renovate:\\s(?<datasource>\\S+)=(?<depName>\\S+)(?:\\s+registry=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s+FROM\\s+\\S+:(?<currentValue>[\\w+.\\-]+)",
        "#\\s?renovate:\\s(?<datasource>\\S+)=(?<depName>\\S+)(?:\\s+registry=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s+ARG\\s+\\S+_VERSION=(?<currentValue>[\\w+.\\-]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge container image updates after CI passes",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Pin iii-hq/iii to 0.11.2 — upstream agentmemory has not migrated to the 0.11.6 sandbox model yet; see https://github.com/rohitg00/agentmemory/blob/main/.env.example section 8",
      "matchDepNames": ["iii-hq/iii"],
      "allowedVersions": "0.11.2"
    }
  ]
}
